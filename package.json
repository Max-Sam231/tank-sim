{
  "name": "tank-driver-sim",
  "version": "0.1.0",
  "private": true,
  "description": "Driver Sim (vanilla HTML/CSS/JS) - development server with auto-reload",
  "scripts": {
    "dev": "concurrently \"node live-reload-server.js\" \"serve -s . -l 8000\"",
    "serve": "serve -s . -l 8000",
    "smoke": "node tests/smoke.mjs",
    "test:physics": "node tests/physics.mjs",
    "test": "npm run smoke && npm run test:physics"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jsdom": "^30.1.1",
    "nodemon": "^3.1.0",
    "serve": "^14.2.0",
    "ws": "^8.16.0"
  }
}
